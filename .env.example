# ==========================================
# Chemistry Companion - Environment Variables
# Prefer: Settings → Setup Wizard (creates .env for you)
# Or copy this file to .env and fill in values
# ==========================================

APP_VERSION=3.0.0
CHEM_COMPANION_SETUP_COMPLETE=0

# Application Settings
CHEM_COMPANION_IMAGE__WIDTH=900
CHEM_COMPANION_EXPORT__DEFAULT_FORMAT=excel
CHEM_COMPANION_BATCH__CHUNK_SIZE=250

# Workspace paths (optional overrides)
# DATABASE_PATH=
# OUTPUT_PATH=
# LOG_PATH=
# CHEM_COMPANION_DB_PATH=
# CHEM_COMPANION_OUTPUTS_DIR=
# CHEM_COMPANION_LOG_PATH=

# ==========================================
# AI / LLM Configuration
# AI_PROVIDER: openrouter | openai | groq | ollama | disabled
# ==========================================
AI_PROVIDER=disabled
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# DEFAULT_FAST_PROVIDER=groq
# DEFAULT_REASONING_PROVIDER=gemini
# FALLBACK_CHAIN=groq,deepseek,openrouter,gemini
