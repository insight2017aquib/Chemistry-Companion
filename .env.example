# ==========================================
# Chemistry Companion - Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# Application Settings
export CHEM_COMPANION_IMAGE__WIDTH=900
export CHEM_COMPANION_EXPORT__DEFAULT_FORMAT=excel
export CHEM_COMPANION_BATCH__CHUNK_SIZE=250

# ==========================================
# LLM Configuration
# Set LLM_PROVIDER to openrouter or deepseek
# ==========================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-...

# ==========================================
# Optional: Future configurations
# ==========================================
# export OPENAI_API_KEY=sk-...
# export DATABASE_URL=...
